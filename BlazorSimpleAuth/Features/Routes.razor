<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Features.Home.Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView Context="AuthContext" RouteData="@routeData" DefaultLayout="@typeof(Features.Layout.MainLayout)" >
                <NotAuthorized>
                    You are not authorized, please login.
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
    </Router>
</CascadingAuthenticationState>
